# ============================================
# StegShield X — Backend Production Environment Template
# ============================================

NODE_ENV=production
PORT=4000

# Primary Domain Configuration (Replace with your domain)
# Example: https://secureshare.duckdns.org or https://yourdomain.com
APP_URL=https://yourdomain.com
CORS_ORIGIN=https://yourdomain.com

# Database & Redis Connection
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/stegshield?schema=public"
REDIS_URL="redis://redis:6379"

# Production Secrets (Generate strong random strings for each)
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_EXPIRATION=15m
REFRESH_TOKEN_SECRET=change-me-to-a-random-64-char-hex-string
REFRESH_TOKEN_EXPIRATION=7d
RESET_TOKEN_SECRET=change-me-to-a-random-64-char-hex-string
ENCRYPTION_KEY=change-me-to-a-base64-32-byte-key
SECRET_KEY=change-me-to-a-hex-64-byte-key

# Microservice & Security
AI_SERVICE_URL=http://ai-service:8000
AI_API_KEY=change-me-in-production
AI_API_KEY_REQUIRED=true

# Secure File Sharing Production Defaults
SHARING_DEFAULT_IP_RESTRICTED=false
SHARING_DEFAULT_ALLOWED_IPS=
SHARING_DEFAULT_MAX_DOWNLOADS=10
SHARING_DEFAULT_EXPIRY=24h
SHARING_REQUIRE_PASSWORD=true
